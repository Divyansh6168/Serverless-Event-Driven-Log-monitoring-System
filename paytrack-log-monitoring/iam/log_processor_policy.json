{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "CloudWatchLogs",
			"Effect": "Allow",
			"Action": [
				"logs:CreateLogGroup",
				"logs:CreateLogStream",
				"logs:PutLogEvents"
			],
			"Resource": "*"
		},
		{
			"Sid": "DynamoDB",
			"Effect": "Allow",
			"Action": [
				"dynamodb:PutItem",
				"dynamodb:Scan"
			],
			"Resource": "*"
		},
		{
			"Sid": "SNSPublish",
			"Effect": "Allow",
			"Action": [
				"sns:Publish"
			],
			"Resource": "*"
		}
	]
}
